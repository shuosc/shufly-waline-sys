# LeanCloud database
LEAN_ID=
LEAN_KEY=
LEAN_MASTER_KEY=
LEAN_SERVER=

# Only allow requests from the SHUFly site and the Waline service itself.
# Do not include https:// or URL paths.
SECURE_DOMAINS=shuosc.github.io,shufly-waline-sys.vercel.app

# Site and administrator notification
SITE_NAME=上海大学溯源手册
SITE_URL=https://shuosc.github.io/fly/
AUTHOR_EMAIL=
DISABLE_AUTHOR_NOTIFY=false

# SMTP mail delivery
# Use SMTP_SERVICE, or use SMTP_HOST together with SMTP_PORT.
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SENDER_NAME=SHUFly 评论通知
SENDER_EMAIL=
